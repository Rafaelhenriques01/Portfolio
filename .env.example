# ---------------------------------------------------------------
# Envio de e-mail do formulario de contato
# (usado pela Serverless Function em /api/contact.js)
# ---------------------------------------------------------------

# E-mail que RECEBE as mensagens enviadas pelo formulario
CONTACT_TO_EMAIL=7591rafa@gmail.com

# --- Opcao 1 (em uso): SMTP do Gmail -----------------------------
# Requer verificacao em 2 etapas ativa na conta Google e uma
# "Senha de app" gerada em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=7591rafa@gmail.com
SMTP_PASS=senha-de-app-de-16-caracteres

# --- Opcao 2 (alternativa): API do Resend ------------------------
# Se preenchida, so e usada quando SMTP_USER/SMTP_PASS estiverem vazios
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
